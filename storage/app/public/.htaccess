# Uploaded files only (served at /storage through public/storage).
# Never run or serve scripts from here, even if one is written by mistake.
# "(\.|$)" also catches double extensions such as shell.php.png.
<FilesMatch "(?i)\.(php\d*|phtml|phar|phps|pht|shtml|cgi|pl|py|sh|asp|aspx|jsp)(\.|$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
