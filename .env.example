APP_NAME=LSPDMS
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=30
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database (Laragon MySQL: user root, no password)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lspdms
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
# Sign out after this many minutes without real activity (0 = never)
SESSION_IDLE_MINUTES=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

# Live chat (Reverb). "local" is replaced by unique keys on each new PC
REVERB_APP_ID=lspdms
REVERB_APP_KEY=local
REVERB_APP_SECRET=local
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Mail: the launcher fills the username / password / from-address on every PC
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# No external AI API keys are needed for the built-in help chatbot.

# Protected IT recovery account (see docs/it-recovery.md). The password is never
# put here: set it with `php artisan lspdms:it-recovery:provision`.
# IT_RECOVERY_EMAIL: default email used by the provision command.
# IT_RECOVERY_ALLOWED_IPS: optional comma-separated client IPs allowed to open /it-recovery (empty = any).
IT_RECOVERY_EMAIL=
IT_RECOVERY_ALLOWED_IPS=
